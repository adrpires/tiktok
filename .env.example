# gemini usa a chave gratuita do AI Studio. xai usa o Grok. compativel usa SCRIPT_*.
SCRIPT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Narração emocionada, com a mesma GEMINI_API_KEY. Charon é a voz masculina grave.
